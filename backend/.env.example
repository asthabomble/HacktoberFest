# Which model provider to use: "google" (Google AI Studio) or "ollama" (local)
AI_PROVIDER=google

# --- Google AI Studio ---
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemma-4-26b-a4b-it
# How long Gemma 4 "thinks" before answering. minimal = ~2s per call; leave empty for the
# model default (~10s per call, can help with very messy handwriting)
GOOGLE_THINKING_LEVEL=minimal

# --- Ollama (local) ---
# Install: https://ollama.com  then: ollama pull gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Seconds to wait for a model response (vision calls can be slow)
AI_TIMEOUT_SECONDS=90

# SQLite now; swap for postgresql://user:pass@host/db later
DATABASE_URL=sqlite:///./data/hisaabkitaab.db

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# --- Google OAuth (Web application credentials, separate from GOOGLE_API_KEY) ---
# Create these in Google Cloud Console > APIs & Services > Credentials.
# Add http://localhost:5173 as an authorized JavaScript origin.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match an authorized redirect URI in Google Cloud Console.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
