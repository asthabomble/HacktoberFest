# Leave empty in dev (Vite proxies /api to localhost:8000).
# Set to the deployed backend URL for production builds.
VITE_API_URL=

# Optional: public OAuth client ID for the Google sign-in button. If empty, the app reads
# GOOGLE_OAUTH_CLIENT_ID from the backend (/api/auth/config). Never put a client secret here.
VITE_GOOGLE_CLIENT_ID=
